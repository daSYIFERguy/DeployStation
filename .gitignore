# OS
.DS_Store
**/.DS_Store

# Station runtime data (users, OAuth secrets, credentials, logs)
secure/.secure-station-data/config.json
secure/.secure-station-data/admin-settings.json
secure/.secure-station-data/projects.json
secure/.secure-station-data/activity.log
secure/.secure-station-data/access-requests.json
secure/.secure-station-data/user-profiles/
secure/.secure-station-data/project-settings/
secure/.secure-station-data/project-credentials/
secure/.secure-station-data/archives/
secure/.secure-station-data/archived-projects/
